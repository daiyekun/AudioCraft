<Window x:Class="AudioCraft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AudioCraft"
        mc:Ignorable="d"
        Title="AudioCraft - 音频格式转换器" Height="800" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1e2a3a"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        Loaded="Window_Loaded">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#00d4ff"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#9b59b6"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1e2a3a"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#2a3a4a"/>
        <SolidColorBrush x:Key="TextBrush" Color="#ffffff"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#c0c0c0"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#00ff88"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#ff4444"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#ffaa00"/>

        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00ffff"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="Foreground" Value="#ffffff"/>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#2a3a4a"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#00d4ff"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" Background="Transparent">
                                                    <Path x:Name="Arrow"
                                                          Data="M 0 0 L 10 10 L 20 0"
                                                          Stroke="#ffffff"
                                                          StrokeThickness="2"
                                                          Fill="Transparent"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="contentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="dropdown"
                                      Width="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      MinWidth="{TemplateBinding ActualWidth}">
                                    <Border x:Name="dropdownBorder"
                                            Background="#2a3a4a"
                                            BorderBrush="#00d4ff"
                                            BorderThickness="1"
                                            CornerRadius="4"/>
                                    <ScrollViewer Margin="4"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#00ffff"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00d4ff"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00a0cc"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberGroupBox" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#4a5a6a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#00d4ff"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" 
                                    Background="#2a3a4a" 
                                    CornerRadius="6,6,0,0" 
                                    Padding="12,8">
                                <ContentPresenter ContentSource="Header"/>
                            </Border>
                            <Border Grid.Row="1" 
                                    Background="#2a3a4a" 
                                    CornerRadius="0,0,6,6" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="AudioCraft" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="音频格式转换器" 
                               FontSize="12" 
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="格式选择：" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               VerticalAlignment="Center" 
                               Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbSourceFormat" 
                              Style="{StaticResource ComboBoxStyle}" 
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                              Width="100" 
                              Margin="0,0,10,0"
                              SelectedIndex="0">
                        <ComboBoxItem Content="AWB"/>
                        <ComboBoxItem Content="WAV"/>
                        <ComboBoxItem Content="FLAC"/>
                        <ComboBoxItem Content="OGG"/>
                    </ComboBox>
                    <TextBlock Text="→" 
                               Foreground="{StaticResource PrimaryBrush}" 
                               FontSize="20" 
                               VerticalAlignment="Center" 
                               Margin="5,0"/>
                    <ComboBox x:Name="cmbTargetFormat" 
                              Style="{StaticResource ComboBoxStyle}" 
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                              Width="100" 
                              Margin="10,0,0,0"
                              SelectedIndex="1">
                        <ComboBoxItem Content="MP3"/>
                        <ComboBoxItem Content="WAV"/>
                        <ComboBoxItem Content="FLAC"/>
                        <ComboBoxItem Content="AAC"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Drop Zone / File List -->
            <Border Grid.Column="0" 
                    x:Name="dropZone"
                    Background="{StaticResource SurfaceBrush}" 
                    CornerRadius="10"
                    BorderThickness="2"
                    BorderBrush="#4a5a6a"
                    Padding="15">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel x:Name="emptyState" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Center"
                                Visibility="Visible">
                        <TextBlock Text="📁" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="拖拽音频文件到此处" 
                                   FontSize="20" 
                                   Foreground="{StaticResource TextBrush}" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="或点击下方按钮添加文件" 
                                   FontSize="14" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- File List -->
                    <Grid x:Name="fileListContainer" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="10,8" Background="#222244" CornerRadius="6,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="文件名" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="大小" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="2" Text="状态" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="3" Text="进度" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <ListBox x:Name="lstFiles" 
                                 Grid.Row="1" 
                                 Background="Transparent" 
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" BorderBrush="#333366" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FileSize}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StatusBrush}"/>
                                            <ProgressBar Grid.Column="3" 
                                                         Value="{Binding Progress}" 
                                                         Maximum="100" 
                                                         Height="16"
                                                         Background="#333366"
                                                         Foreground="{StaticResource PrimaryBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Drag Overlay -->
                    <Border x:Name="dragOverlay" 
                            Background="#4400d4ff" 
                            CornerRadius="10" 
                            Visibility="Collapsed"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="释放以添加文件" 
                                       FontSize="24" 
                                       Foreground="{StaticResource PrimaryBrush}" 
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Panel -->
            <Grid Grid.Column="1" Margin="20,0,0,0" Width="220">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Add Files Button -->
                <Button Grid.Row="0" 
                        Style="{StaticResource CyberButton}" 
                        Click="BtnAddFiles_Click"
                        Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="18" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock Text="添加文件"/>
                    </StackPanel>
                </Button>

                <!-- Source Folder Group -->
                <GroupBox Grid.Row="1" 
                          Header="原始文件目录" 
                          Style="{StaticResource CyberGroupBox}">
                    <StackPanel>
                        <TextBlock x:Name="txtSourcePath" 
                                   Text="未设置" 
                                   Foreground="{StaticResource TextBrush}" 
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" 
                                    Click="BtnChangeSource_Click"
                                    Padding="10,8"
                                    FontSize="12"
                                    Margin="0,0,8,0">
                                <TextBlock Text="选择目录"/>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" 
                                    Click="BtnLoadSource_Click"
                                    Padding="10,8"
                                    FontSize="12">
                                <TextBlock Text="加载文件"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Output Folder Group -->
                <GroupBox Grid.Row="2" 
                          Header="目标目录" 
                          Style="{StaticResource CyberGroupBox}">
                    <StackPanel>
                        <TextBlock x:Name="txtOutputPath" 
                                   Text="未设置" 
                                   Foreground="{StaticResource TextBrush}" 
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" 
                                    Click="BtnChangeOutput_Click"
                                    Padding="10,8"
                                    FontSize="12"
                                    Margin="0,0,8,0">
                                <TextBlock Text="另存为"/>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" 
                                    Click="BtnOpenOutput_Click"
                                    Padding="10,8"
                                    FontSize="12">
                                <TextBlock Text="打开目录"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Convert Button -->
                <Button Grid.Row="3" 
                        x:Name="btnConvert"
                        Style="{StaticResource CyberButton}" 
                        Click="BtnConvert_Click"
                        IsEnabled="False"
                        Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▶" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="开始转换"/>
                    </StackPanel>
                </Button>

                <!-- Log Panel -->
                <Border Grid.Row="4" 
                        Background="{StaticResource SurfaceBrush}" 
                        CornerRadius="8" 
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="转换日志" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                        <ScrollViewer x:Name="logScroller" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="txtLog" 
                                     Background="Transparent" 
                                     Foreground="{StaticResource TextBrush}"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas"
                                     FontSize="11"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Clear Button -->
                <Button Grid.Row="5" 
                        Style="{StaticResource SecondaryButton}" 
                        Background="#444444"
                        Click="BtnClear_Click"
                        Margin="0,10,0,0"
                        Padding="12,6"
                        FontSize="12">
                    <TextBlock Text="清空列表"/>
                </Button>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtStatus" 
                           Text="就绪" 
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" 
                           x:Name="txtFileCount" 
                           Text="0 个文件" 
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
